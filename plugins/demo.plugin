[General]
bypass-tun = 
skip-proxy = 
real-ip = 
dns-server = 

[Rule]

[Rewrite]
^http:\/\/app2025\.xuanyou168\.com:8099\/user\/getUserData response-body-replace-regex "vipState":0 "vipState":1

[Host]

[Script]
http-response ^http:\/\/app2025\.xuanyou168\.com:8099\/user\/getUserData script-path=https://raw.githubusercontent.com/Kyler404/loon-plugin-demo/refs/heads/main/scripts/demo.js,argument={region,level},enabled={enabled},requires-body=true,binary-body-mode=false,tag=随机号码