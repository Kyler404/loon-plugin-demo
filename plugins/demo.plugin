#!name=Demo Plugin
#!desc=一个最小的 Loon 插件示例，演示规则 / 复写 / 脚本 / MITM 四块组合
#!icon=https://raw.githubusercontent.com/kyler404/loon-plugin-demo/main/assets/icon.png
#!author=kyler404
#!homepage=https://github.com/kyler404/loon-plugin-demo
#!tag=Proxy
#!system=iOS,iPadOS,tvOS,macOS

[Rule]
DOMAIN-SUFFIX,example.com,DIRECT
AND,((DOMAIN-KEYWORD,ads),(USER-AGENT,*AdBot*)),REJECT

[URL Rewrite]
^https?:\/\/(www\.)?example\.cn\/path https://example.com/path 302

[Script]
http-response ^https?:\/\/api\.example\.com\/v1\/user script-path=https://raw.githubusercontent.com/kyler404/loon-plugin-demo/main/scripts/demo.js, requires-body=true, timeout=10, tag=DemoUser

[MITM]
hostname = api.example.com, *.example.cn
